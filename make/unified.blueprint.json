{
  "name": "Contacts+ to iCloud mapping gate scaffold",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {}
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "mapper": {
        "array": "{{1.events}}"
      }
    },
    {
      "id": 7,
      "module": "datastore:ExistRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.data.contactId}}"
      },
      "filter": {
        "name": "Source contact ID required",
        "conditions": [
          [
            {
              "a": "{{2.data.contactId}}",
              "o": "exist"
            },
            {
              "a": "{{2.data.contactId}}",
              "b": "",
              "o": "text:notequal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Check exact contact mapping \u2014 no writes"
        }
      }
    },
    {
      "id": 8,
      "module": "datastore:GetRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.data.contactId}}",
        "returnWrapped": false
      },
      "filter": {
        "name": "Mapping exists",
        "conditions": [
          [
            {
              "a": "{{7.exist}}",
              "b": true,
              "o": "boolean:equal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Read verified mapping \u2014 no writes"
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "filter": {
        "name": "Exact verified mapping only",
        "conditions": [
          [
            {
              "a": "{{8.state}}",
              "b": "verified",
              "o": "text:equal"
            },
            {
              "a": "{{8.sourceAccountId}}",
              "b": "contactsplus-primary",
              "o": "text:equal"
            },
            {
              "a": "{{8.sourceContactId}}",
              "b": "{{2.data.contactId}}",
              "o": "text:equal"
            }
          ]
        ]
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.added"
              },
              "filter": {
                "name": "Contact added",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.added",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify added event \u2014 no writes"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.updated"
              },
              "filter": {
                "name": "Contact updated",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.updated",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify updated event \u2014 no writes"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.deleted"
              },
              "filter": {
                "name": "Contact deleted",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.deleted",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify deleted event \u2014 no writes"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "sequential": true,
      "confidential": true,
      "dlq": true,
      "dataloss": false
    }
  }
}
