{
  "name": "Contacts+ \u2192 iCloud \u2014 event routing verification",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {}
    },
    {
      "id": 2,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "mapper": {
        "array": "{{1.events}}"
      }
    },
    {
      "id": 9,
      "module": "datastore:ExistRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.eventId}}"
      },
      "filter": {
        "name": "Recognized event with IDs",
        "conditions": [
          [
            {
              "a": "{{2.eventId}}",
              "o": "exist"
            },
            {
              "a": "{{2.eventId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.data.contactId}}",
              "o": "exist"
            },
            {
              "a": "{{2.data.contactId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.triggerId}}",
              "b": "contact.added",
              "o": "text:equal"
            }
          ],
          [
            {
              "a": "{{2.eventId}}",
              "o": "exist"
            },
            {
              "a": "{{2.eventId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.data.contactId}}",
              "o": "exist"
            },
            {
              "a": "{{2.data.contactId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.triggerId}}",
              "b": "contact.updated",
              "o": "text:equal"
            }
          ],
          [
            {
              "a": "{{2.eventId}}",
              "o": "exist"
            },
            {
              "a": "{{2.eventId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.data.contactId}}",
              "o": "exist"
            },
            {
              "a": "{{2.data.contactId}}",
              "b": "",
              "o": "text:notequal"
            },
            {
              "a": "{{2.triggerId}}",
              "b": "contact.deleted",
              "o": "text:equal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Check previously received event"
        }
      }
    },
    {
      "id": 10,
      "module": "datastore:AddRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.eventId}}",
        "data": {
          "state": "pending",
          "eventId": "{{2.eventId}}",
          "triggerId": "{{2.triggerId}}",
          "receivedAt": "{{now}}",
          "sourceAccountId": "contactsplus-primary",
          "sourceContactId": "{{2.data.contactId}}"
        },
        "overwrite": false
      },
      "filter": {
        "name": "First delivery only",
        "conditions": [
          [
            {
              "a": "{{9.exist}}",
              "b": false,
              "o": "boolean:equal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Retain new event for processing"
        }
      }
    },
    {
      "id": 7,
      "module": "datastore:ExistRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.data.contactId}}"
      },
      "filter": {
        "name": "Source contact ID required",
        "conditions": [
          [
            {
              "a": "{{2.data.contactId}}",
              "o": "exist"
            },
            {
              "a": "{{2.data.contactId}}",
              "b": "",
              "o": "text:notequal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Check exact contact mapping \u2014 no writes"
        }
      }
    },
    {
      "id": 8,
      "module": "datastore:GetRecord",
      "version": 1,
      "mapper": {
        "key": "contactsplus-primary:{{2.data.contactId}}",
        "returnWrapped": false
      },
      "filter": {
        "name": "Mapping exists",
        "conditions": [
          [
            {
              "a": "{{7.exist}}",
              "b": true,
              "o": "boolean:equal"
            }
          ]
        ]
      },
      "parameters": {},
      "metadata": {
        "designer": {
          "name": "Read verified mapping \u2014 no writes"
        }
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicRouter",
      "version": 1,
      "filter": {
        "name": "Exact verified mapping only",
        "conditions": [
          [
            {
              "a": "{{8.state}}",
              "b": "verified",
              "o": "text:equal"
            },
            {
              "a": "{{8.sourceAccountId}}",
              "b": "contactsplus-primary",
              "o": "text:equal"
            },
            {
              "a": "{{8.sourceContactId}}",
              "b": "{{2.data.contactId}}",
              "o": "text:equal"
            }
          ]
        ]
      },
      "routes": [
        {
          "flow": [
            {
              "id": 4,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.added"
              },
              "filter": {
                "name": "Contact added",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.added",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify added event \u2014 no writes"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 5,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.updated"
              },
              "filter": {
                "name": "Contact updated",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.updated",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify updated event \u2014 no writes"
                }
              }
            },
            {
              "id": 11,
              "module": "contactsplus:getContact",
              "version": 1,
              "mapper": {
                "listType": "contactId",
                "contactId": "{{8.sourceContactId}}"
              },
              "parameters": {},
              "metadata": {
                "designer": {
                  "name": "Read current mapped source contact"
                }
              }
            },
            {
              "id": 12,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "get",
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "stopOnHttpError": true,
                "requestCompressedContent": false
              },
              "filter": {
                "name": "Exact source and configured target only",
                "conditions": [
                  [
                    {
                      "a": "{{11.contactId}}",
                      "b": "{{8.sourceContactId}}",
                      "o": "text:equal"
                    },
                    {
                      "a": "{{8.targetUid}}",
                      "b": "^[A-Za-z0-9_-]{1,128}$",
                      "o": "text:pattern"
                    },
                    {
                      "a": "{{8.targetHref}}",
                      "b": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "authenticationType": "basicAuth"
              },
              "metadata": {
                "designer": {
                  "name": "Read exact mapped iCloud card \u2014 no duplicate search"
                }
              }
            },
            {
              "id": 13,
              "module": "code:ExecuteCode",
              "version": 1,
              "mapper": {
                "input": [
                  {
                    "name": "source",
                    "value": "{{`11`}}"
                  },
                  {
                    "name": "sourceContactId",
                    "value": "{{8.sourceContactId}}"
                  },
                  {
                    "name": "uid",
                    "value": "{{8.targetUid}}"
                  },
                  {
                    "name": "existingVcard",
                    "value": "{{12.data}}"
                  },
                  {
                    "name": "targetEtag",
                    "value": "{{12.headers.etag}}"
                  },
                  {
                    "name": "eventId",
                    "value": "{{2.eventId}}"
                  }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "codeEditorJavascript": "// Pure conversion for Make Code. No network, filesystem, or credentials.\nfunction convert(input) {\n  const text = value => {\n    if (value == null) return '';\n    if (typeof value !== 'string' || /[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f]/.test(value))\n      throw new Error('Invalid text value');\n    return value;\n  };\n  const escape = value => text(value).replace(/\\\\/g, '\\\\\\\\').replace(/\\r\\n|\\r|\\n/g, '\\\\n').replace(/;/g, '\\\\;').replace(/,/g, '\\\\,');\n  const fold = line => {\n    let out = '', width = 0;\n    for (const ch of line) {\n      const size = Buffer.byteLength(ch, 'utf8');\n      if (width + size > 75) { out += '\\r\\n '; width = 1; }\n      out += ch; width += size;\n    }\n    return out;\n  };\n  const uid = text(input.uid);\n  if (!/^[A-Za-z0-9_-]{1,128}$/.test(uid)) throw new Error('A safe stable target UID is required');\n  const data = typeof input.contactData === 'string' ? JSON.parse(input.contactData) : input.contactData;\n  if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('contactData must be an object');\n  const nameLines = () => {\n    const n = data.name;\n    if (!n || typeof n !== 'object' || Array.isArray(n)) throw new Error('Structured name required');\n    const keys = ['familyName','givenName','middleName','prefix','suffix'];\n    if (Object.keys(n).some(k => !keys.includes(k) && n[k])) throw new Error('Unsupported name component');\n    const fn = ['prefix','givenName','middleName','familyName','suffix'].map(k=>text(n[k])).filter(Boolean).join(' ');\n    if (!fn.trim()) throw new Error('Nonempty name required');\n    return ['N:' + keys.map(k=>escape(n[k])).join(';'), 'FN:' + escape(fn)];\n  };\n  if (input.mode === 'patch-name-notes') {\n    const prior = text(input.existingVcard);\n    if (/\\r(?!\\n)|(?<!\\r)\\n/.test(prior) || !prior.endsWith('\\r\\n')) throw new Error('Expected CRLF vCard');\n    const physical = prior.slice(0,-2).split('\\r\\n');\n    const records = [];\n    for (const line of physical) {\n      if (/^[ \\t]/.test(line)) {\n        if (!records.length) throw new Error('Invalid folding');\n        records[records.length-1].raw += '\\r\\n' + line;\n        records[records.length-1].logical += line.slice(1);\n      } else records.push({raw:line,logical:line});\n    }\n    const logical = records.map(r=>r.logical);\n    if (logical[0] !== 'BEGIN:VCARD' || logical.at(-1) !== 'END:VCARD' || logical.filter(l=>l==='BEGIN:VCARD').length !== 1 || logical.filter(l=>l==='END:VCARD').length !== 1 || logical.filter(l=>l==='VERSION:3.0').length !== 1)\n      throw new Error('Expected one vCard 3.0');\n    if (logical.filter(l=>/^UID[;:]/i.test(l)).length !== 1 || !logical.includes('UID:'+uid)) throw new Error('Target UID mismatch');\n    const requested = Object.keys(data);\n    if (!requested.length || requested.some(k=>!['name','notes'].includes(k))) throw new Error('Patch supports only explicit name and notes');\n    const desired = [...(requested.includes('name')?nameLines():[]), ...(requested.includes('notes')?['NOTE:'+escape(data.notes)]:[])];\n    const property = r => r.logical.split(':')[0].split(';')[0].split('.').at(-1).toUpperCase();\n    const additions = desired.filter(line => {\n      const key = line.slice(0,line.indexOf(':'));\n      const current = records.filter(r => property(r) === key);\n      if (current.some(r => /[;.]/.test(r.logical.split(':')[0]))) throw new Error('Qualified managed property needs manual handling');\n      if (current.length > 1) throw new Error('Ambiguous repeated managed property');\n      // An absent note and an explicitly empty note have the same effect.\n      if (!current.length && line === 'NOTE:') return false;\n      return !current.length || current[0].logical.slice(current[0].logical.indexOf(':')+1) !== line.slice(line.indexOf(':')+1);\n    });\n    if (!additions.length) return {vcard:prior,uid,mode:input.mode,changed:false};\n    const replace = new Set(additions.map(line => line.slice(0,line.indexOf(':'))));\n    const kept = records.filter(r => !replace.has(property(r))).map(r=>r.raw);\n    kept.splice(kept.length-1,0,...additions.map(fold));\n    return {vcard:kept.join('\\r\\n')+'\\r\\n',uid,mode:input.mode,changed:true};\n  }\n  if (input.mode !== 'create') throw new Error('Explicit create or patch-name-notes mode required');\n  const allowed = ['name','notes','emails','phoneNumbers'];\n  if (Object.keys(data).some(k=>!allowed.includes(k) && data[k] != null && data[k] !== '' && !(Array.isArray(data[k]) && !data[k].length)))\n    throw new Error('Unsupported populated field; do not drop source data');\n  const lines = ['BEGIN:VCARD','VERSION:3.0','UID:'+uid,...nameLines()];\n  for (const [key,property,types] of [['emails','EMAIL',['HOME','WORK','INTERNET']],['phoneNumbers','TEL',['HOME','WORK','CELL','VOICE','FAX','PAGER']]]) {\n    const entries = data[key] ?? [];\n    if (!Array.isArray(entries)) throw new Error('Expected contact value array');\n    for (const e of entries) {\n      if (!e || Object.keys(e).some(k=>!['type','value'].includes(k))) throw new Error('Unsupported contact value field');\n      const value = text(e.value);\n      if (!value || /[\\r\\n]/.test(value)) throw new Error('Invalid email or phone');\n      const label = text(e.type).toUpperCase();\n      if (label && !types.includes(label)) throw new Error('Unsupported label');\n      lines.push(property+(label?';TYPE='+label:'')+':'+escape(value));\n    }\n  }\n  if (Object.hasOwn(data,'notes')) lines.push('NOTE:'+escape(data.notes));\n  lines.push('END:VCARD');\n  return {vcard:lines.map(fold).join('\\r\\n')+'\\r\\n',uid,mode:input.mode};\n}\n\n\n// Map inputs as data, never interpolate contact fields into this code.\nconst source = typeof input.source === \"string\" ? JSON.parse(input.source) : input.source;\nif (!source || source.contactId !== input.sourceContactId) throw new Error(\"Source identity mismatch\");\nif (typeof input.targetEtag !== \"string\" || !/^\"[^\"\\r\\n]+\"$/.test(input.targetEtag)) throw new Error(\"Strong target ETag required\");\nconst data = source.contactData;\nif (!data || typeof data !== \"object\") throw new Error(\"Source data required\");\nconst patch = {};\nfor (const key of [\"name\", \"notes\"]) {\n  if (Object.prototype.hasOwnProperty.call(data, key) && data[key] != null) patch[key] = data[key];\n}\nif (!Object.keys(patch).length) throw new Error(\"No supported source fields\");\nconst prepared = convert({mode:\"patch-name-notes\",uid:input.uid,existingVcard:input.existingVcard,contactData:patch});\nreturn {...prepared, beforeVcard:input.existingVcard, targetEtag:input.targetEtag,\n  sourceEtag:source.etag, eventId:input.eventId, status:prepared.changed ? \"prepared-only\" : \"unchanged\", writesApplied:false};\n"
              },
              "metadata": {
                "designer": {
                  "name": "Prepare name and notes update \u2014 no writes"
                }
              }
            },
            {
              "id": 14,
              "module": "datastore:UpdateRecord",
              "version": 1,
              "mapper": {
                "key": "contactsplus-primary:{{2.eventId}}",
                "data": {
                  "state": "{{if(13.result.changed; \"prepared_name_notes\"; \"unchanged_name_notes\")}}"
                },
                "upsert": false,
                "overwriteArrays": false
              },
              "parameters": {},
              "metadata": {
                "designer": {
                  "name": "Record name and notes preparation outcome"
                }
              }
            },
            {
              "id": 16,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "put",
                "headers": [
                  {
                    "name": "If-Match",
                    "value": "{{13.result.targetEtag}}"
                  }
                ],
                "contentType": "custom",
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "rawBodyContent": "{{13.result.vcard}}",
                "stopOnHttpError": true,
                "contentTypeValue": "text/vcard; charset=utf-8",
                "requestCompressedContent": false
              },
              "filter": {
                "name": "Prepared change only",
                "conditions": [
                  [
                    {
                      "a": "{{13.result.changed}}",
                      "b": true,
                      "o": "boolean:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "authenticationType": "basicAuth"
              },
              "metadata": {
                "designer": {
                  "name": "Apply prepared name and notes with version guard"
                }
              }
            },
            {
              "id": 17,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "get",
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "stopOnHttpError": true,
                "requestCompressedContent": false
              },
              "parameters": {
                "authenticationType": "basicAuth"
              },
              "metadata": {
                "designer": {
                  "name": "Read applied target"
                }
              }
            },
            {
              "id": 18,
              "module": "code:ExecuteCode",
              "version": 1,
              "mapper": {
                "input": [
                  {
                    "name": "actual",
                    "value": "{{17.data}}"
                  },
                  {
                    "name": "expected",
                    "value": "{{13.result.vcard}}"
                  },
                  {
                    "name": "etag",
                    "value": "{{17.headers.etag}}"
                  }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "codeEditorJavascript": "function canonical(card) { if(typeof card!==\"string\") throw Error(\"Missing readback\");return card.replace(/\\r\\n[ \\t]/g,\"\").split(/\\r?\\n/).filter(x=>x&&!/^(REV|PRODID):/.test(x)).sort(); }\nif(JSON.stringify(canonical(input.actual))!==JSON.stringify(canonical(input.expected)))throw Error(\"Target readback differs from prepared card; do not retry write\");\nif(!/^\"[^\"\\r\\n]+\"$/.test(input.etag))throw Error(\"Missing strong readback ETag\");\nreturn {verified:true,targetEtag:input.etag};"
              },
              "metadata": {
                "designer": {
                  "name": "Verify all prepared fields on target"
                }
              }
            },
            {
              "id": 19,
              "module": "datastore:UpdateRecord",
              "version": 1,
              "mapper": {
                "key": "contactsplus-primary:{{2.eventId}}",
                "data": {
                  "state": "verified_name_notes"
                },
                "upsert": false,
                "overwriteArrays": false
              },
              "parameters": {},
              "metadata": {
                "designer": {
                  "name": "Mark name and notes write verified"
                }
              }
            }
          ]
        },
        {
          "flow": [
            {
              "id": 6,
              "module": "util:SetVariable2",
              "version": 1,
              "mapper": {
                "name": "verifiedEventType",
                "value": "contact.deleted"
              },
              "filter": {
                "name": "Contact deleted",
                "conditions": [
                  [
                    {
                      "a": "{{2.triggerId}}",
                      "b": "contact.deleted",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "metadata": {
                "designer": {
                  "name": "Verify deleted event \u2014 no writes"
                }
              }
            },
            {
              "id": 20,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "get",
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "stopOnHttpError": true,
                "requestCompressedContent": false
              },
              "filter": {
                "name": "Mapped target only",
                "conditions": [
                  [
                    {
                      "a": "{{8.targetUid}}",
                      "b": "^[A-Za-z0-9_-]{1,128}$",
                      "o": "text:pattern"
                    },
                    {
                      "a": "{{8.targetHref}}",
                      "b": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                      "o": "text:equal"
                    }
                  ]
                ]
              },
              "parameters": {
                "authenticationType": "basicAuth"
              }
            },
            {
              "id": 21,
              "module": "code:ExecuteCode",
              "version": 1,
              "mapper": {
                "input": [
                  {
                    "name": "card",
                    "value": "{{20.data}}"
                  },
                  {
                    "name": "uid",
                    "value": "{{8.targetUid}}"
                  },
                  {
                    "name": "etag",
                    "value": "{{20.headers.etag}}"
                  }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "codeEditorJavascript": "const c=input.card.replace(/\\r\\n[ \\t]/g,\"\"); const u=c.split(/\\r?\\n/).filter(l=>/^UID[;:]/i.test(l));if(u.length!==1||u[0]!==\"UID:\"+input.uid)throw Error(\"Target identity mismatch\");if(!/^\"[^\"\\r\\n]+\"$/.test(input.etag))throw Error(\"Strong ETag required\");return {verified:true};"
              }
            },
            {
              "id": 23,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "delete",
                "headers": [
                  {
                    "name": "If-Match",
                    "value": "{{20.headers.etag}}"
                  }
                ],
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "stopOnHttpError": true,
                "requestCompressedContent": false
              },
              "parameters": {
                "authenticationType": "basicAuth"
              }
            },
            {
              "id": 24,
              "module": "http:MakeRequest",
              "version": 4,
              "mapper": {
                "url": "https://icloud-carddav.example.invalid/book/{{8.targetUid}}.vcf",
                "method": "get",
                "shareCookies": false,
                "parseResponse": false,
                "allowRedirects": false,
                "stopOnHttpError": false,
                "requestCompressedContent": false
              },
              "parameters": {
                "authenticationType": "basicAuth"
              }
            },
            {
              "id": 25,
              "module": "code:ExecuteCode",
              "version": 1,
              "mapper": {
                "input": [
                  {
                    "name": "status",
                    "value": "{{24.statusCode}}"
                  }
                ],
                "language": "javascript",
                "inputFormat": "editor",
                "codeEditorJavascript": "if(Number(input.status)!==404)throw Error(\"Deletion not confirmed; do not retry\");return {verified:true};"
              }
            },
            {
              "id": 26,
              "module": "datastore:UpdateRecord",
              "version": 1,
              "mapper": {
                "key": "contactsplus-primary:{{2.data.contactId}}",
                "data": {
                  "state": "deleted",
                  "lastEventId": "{{2.eventId}}",
                  "lastVerifiedAt": "{{now}}"
